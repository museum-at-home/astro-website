---
// Footer component
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-section">
      <h4>About Museum at Home</h4>
      <p>Bringing world-class museums directly to your home through virtual tours and educational resources.</p>
    </div>
    
    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/museums">Explore Museums</a></li>
        <li><a href="/virtual-learning">Virtual Learning</a></li>
        <li><a href="/downloads">Downloads</a></li>
      </ul>
    </div>
    
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <a href="mailto:gianna@museumathome.org">gianna@museumathome.org</a></p>
      <p>Location: Newton, MA 02460</p>
    </div>
    
    <div class="footer-section">
      <h4>Follow Us</h4>
      <div class="social-links">
        <a href="#" aria-label="Facebook">Facebook</a>
        <a href="#" aria-label="Twitter">Twitter</a>
        <a href="#" aria-label="Instagram">Instagram</a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <p>&copy; 2026 Museum at Home. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background-color: #333;
    color: #e0e0e0;
    padding: 3rem 2rem 1rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h4 {
    color: white;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .footer-section p {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
  }

  .footer-section li {
    margin-bottom: 0.5rem;
  }

  .footer-section a {
    color: #0099ff;
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-section a:hover {
    color: #33b3ff;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: #555;
    border-radius: 4px;
    transition: background-color 0.3s;
  }

  .social-links a:hover {
    background-color: #0066cc;
    color: white;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid #555;
    text-align: center;
    font-size: 0.9rem;
    color: #999;
  }

  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .social-links {
      flex-direction: column;
    }

    .social-links a {
      display: block;
    }
  }
</style>
