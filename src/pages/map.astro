---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Map - My Website" description="View our map and locations">
  <Navigation />
  <main>
    <h1>Map</h1>
    <p>Explore our locations and find us on the map.</p>
    
    <section>
      <h2>Our Locations</h2>
      <div class="map-container">
        <div class="map-placeholder">
          <p>📍 Interactive map will be displayed here</p>
          <p style="font-size: 0.9rem; color: #999;">Add your map integration (Google Maps, Mapbox, etc.)</p>
        </div>
      </div>
    </section>

    <section>
      <h2>Visit Us</h2>
      <div class="location-grid">
        <div class="location-card">
          <h3>Main Office</h3>
          <p>123 Main Street<br>City, State 12345</p>
          <p><strong>Phone:</strong> (555) 123-4567</p>
        </div>
        <div class="location-card">
          <h3>Secondary Office</h3>
          <p>456 Oak Avenue<br>Another City, State 67890</p>
          <p><strong>Phone:</strong> (555) 987-6543</p>
        </div>
      </div>
    </section>

    <section>
      <h2>Hours</h2>
      <div class="hours">
        <p><strong>Monday - Friday:</strong> 9:00 AM - 6:00 PM</p>
        <p><strong>Saturday:</strong> 10:00 AM - 4:00 PM</p>
        <p><strong>Sunday:</strong> Closed</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    color: #0066cc;
    margin-bottom: 1.5rem;
  }

  h2 {
    color: #004999;
    margin-top: 2rem;
  }

  section {
    margin-bottom: 2rem;
  }

  .map-container {
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .map-placeholder {
    background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
    padding: 3rem;
    text-align: center;
    border-radius: 8px;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .location-card {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1.5rem;
    background-color: #f9f9f9;
  }

  .location-card h3 {
    color: #0066cc;
    margin-bottom: 1rem;
  }

  .location-card p {
    margin-bottom: 0.75rem;
  }

  .hours {
    background-color: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
  }

  .hours p {
    margin-bottom: 0.75rem;
  }
</style>
