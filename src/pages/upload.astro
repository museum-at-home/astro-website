---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Add PDF Document">
  <div class="container">
    <div class="guide-section">
      <h1>📄 Add a PDF to Downloads</h1>
      <p>Follow these simple steps to add a PDF file for users to download:</p>
      
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Copy Your PDF File</h3>
            <p>In VS Code, open the file explorer and drag your PDF file to the <code>public/documents/</code> folder</p>
            <p class="example">Example: <code>public/documents/my-document.pdf</code></p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Open documents.json</h3>
            <p>Open the file <code>src/data/documents.json</code> in VS Code</p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Add Document Entry</h3>
            <p>Add a new entry to the JSON array. Copy this template and fill in your details:</p>
            <pre><code>{"{"} 
  "id": "unique-id",
  "title": "Your Document Title",
  "description": "Brief description of the document",
  "category": "Guide",
  "fileUrl": "/documents/your-file.pdf",
  "thumbnail": null,
  "dateAdded": "2026-10-28T00:00:00Z"
{"}"}</code></pre>
            <p class="note"><strong>Categories:</strong> Guide, Educational, Research, or Other</p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3>Save & Deploy</h3>
            <p>Save the file. The changes will appear on the <a href="/downloads">/downloads</a> page after you deploy to production.</p>
          </div>
        </div>
      </div>

      <div class="quick-reference">
        <h2>Current Documents</h2>
        <p>View all uploaded documents on the <a href="/downloads">downloads page</a></p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .guide-section {
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    padding: 2rem;
  }

  h1 {
    color: #333;
    margin-bottom: 0.5rem;
    font-size: 2rem;
  }

  > p {
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 2rem 0;
  }

  .step {
    display: flex;
    gap: 1.5rem;
  }

  .step-number {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    background: #007bff;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.5rem;
  }

  .step-content {
    flex: 1;
  }

  .step-content h3 {
    color: #333;
    margin: 0 0 0.5rem 0;
  }

  .step-content p {
    color: #666;
    margin: 0.5rem 0;
  }

  code {
    background: #f5f5f5;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    color: #d73a49;
  }

  .example {
    font-size: 0.95rem;
    background: #f9f9f9;
    padding: 0.5rem;
    border-left: 3px solid #007bff;
    margin: 0.5rem 0 !important;
  }

  pre {
    background: #282c34;
    color: #abb2bf;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1rem 0;
    font-size: 0.9rem;
  }

  code {
    background: none;
    color: inherit;
    padding: 0;
  }

  .note {
    font-size: 0.95rem;
    color: #0066cc;
    background: #e7f3ff;
    padding: 0.75rem;
    border-radius: 4px;
    margin: 1rem 0 0 0 !important;
  }

  .quick-reference {
    background: #f0f8ff;
    border: 2px solid #007bff;
    padding: 1.5rem;
    border-radius: 8px;
    margin-top: 2rem;
  }

  .quick-reference h2 {
    color: #333;
    margin-top: 0;
  }

  a {
    color: #007bff;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
