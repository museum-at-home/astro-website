---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Home - My Website" description="Welcome to our website">
  <Navigation />
  <main>
    <div class="logo-section">
      <img src="/images/MAH Logo.jpg" alt="Museum at Home Logo" class="home-logo" />
    </div>
    
    <h1>🚀 Welcome to Museum At Home</h1>
    <p>This special website was designed to help you find online content from museums all over the world. To begin, please explore our Virtual Learning page or use the Explore to discover specific museums of interest. NOTICE: This is an solo passion-project and I'm constantly adding new museums and educational content every day. If you want to see a specific museum added to our database, please feel free to contact me!</p>

    <section>
      <h2>Features</h2>
      <ul>
        <li>Easy to use interface with intuitive navigation</li>
        <li>Multiple different modes of searching</li>
        <li>Built with patients, homeschoolers, and caregivers in mind.</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .logo-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .home-logo {
    max-width: 200px;
    height: auto;
    object-fit: contain;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 1rem;
  }

  h1 {
    color: #0066cc;
    margin-bottom: 1.5rem;
  }

  section {
    margin-top: 2rem;
  }

  ul {
    margin-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  code {
    background-color: #f5f5f5;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
  }
</style>
