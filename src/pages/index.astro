---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Home - My Website" description="Welcome to our website">
  <Navigation />
  <main>
    <h1>🚀 Welcome to Museum At Home</h1>
    <p>This special website will help you find online content from museums all over the world. Edit <code>src/pages/index.astro</code> to get started.</p>

    <section>
      <h2>Features</h2>
      <ul>
        <li>Easy to use interface with intuitive navigation</li>
        <li>Multiple different modes of searching</li>
        <li>Built with patients, homeschoolers, and caregivers in mind.</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    color: #0066cc;
    margin-bottom: 1.5rem;
  }

  section {
    margin-top: 2rem;
  }

  ul {
    margin-left: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  code {
    background-color: #f5f5f5;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
  }
</style>
