---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="Contact Us - My Website" description="Get in touch with us">
  <Navigation />
  <main>
    <h1>Contact Us</h1>
    <p>Have some feedback? Want us to add a specific museum or attraction? Please fill out the form below or reach out using one of our contact methods.</p>
    
    <section>
      <h2>Contact Information</h2>
      <div class="contact-info">
        <div class="info-item">
          <h3>📧 Email</h3>
          <p><a href="mailto:info@example.com">info@example.com</a></p>
        </div>
        <div class="info-item">
          <h3>📞 Phone</h3>
          <p><a href="tel:+15551234567">(555) 123-4567</a></p>
        </div>
        <div class="info-item">
          <h3>📍 Address</h3>
          <p>123 Main Street<br>City, State 12345</p>
        </div>
      </div>
    </section>

    <section>
      <h2>Send us a Message</h2>
      <form class="contact-form">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required />
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="submit-btn">Send Message</button>
      </form>
    </section>

    <section>
      <h2>Follow Us</h2>
      <div class="social-links">
        <a href="#">Facebook</a>
        <a href="#">Twitter</a>
        <a href="#">Instagram</a>
        <a href="#">LinkedIn</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    color: #0066cc;
    margin-bottom: 1.5rem;
  }

  h2 {
    color: #004999;
    margin-top: 2rem;
  }

  section {
    margin-bottom: 2rem;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .info-item {
    background-color: #f9f9f9;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
  }

  .info-item h3 {
    color: #0066cc;
    margin-bottom: 0.75rem;
  }

  .info-item p {
    margin: 0;
  }

  .contact-form {
    margin-top: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #333;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
  }

  .submit-btn {
    background-color: #0066cc;
    color: white;
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .submit-btn:hover {
    background-color: #004999;
    transform: translateY(-2px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: #0066cc;
    color: white;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .social-links a:hover {
    background-color: #004999;
    text-decoration: none;
  }
</style>
